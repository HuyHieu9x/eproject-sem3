@{
    ViewData["Title"] = "Product Page";
}

@model IEnumerable<Shopv2.Models.Product>

<h1>Danh sách sản phẩm</h1>

<p>
    <a asp-controller="Product" asp-action="Create" class="btn btn-primary">Thêm mới</a>
</p>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">Chưa có sản phẩm nào.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên</th>
                <th>Giá</th>
                <th>Danh mục</th>    
                <th>Trạng thái</th>
                <th>Ngày tạo</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@string.Format("{0:N0}", item.Price)</td>
                    <td>@item.Category?.Name</td>
                    <td>@item.Status</td>
                    <td>@item.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a> |
                        <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
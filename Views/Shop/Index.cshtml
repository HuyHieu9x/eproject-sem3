@model Shopv2.Models.ViewModels.ShopIndexViewModel@using System.Globalization@{    Layout = "~/Views/Shared/_Layout.cshtml";}@{    ViewData["Title"] = "Shop Bouquets";    // Hàm format giá tiền    string PriceDisplay(decimal price) => price.ToString("C", CultureInfo.CurrentCulture);}<style>    .account-banner {        background-image: url('/client/wp-content/themes/floomi/assets/images/bg-breadcrumb.jpg');        background-size: cover;        background-position: center;        background-repeat: no-repeat;        padding: 120px 0;        position: relative;    }        .account-banner::before {            content: "";            position: absolute;            inset: 0;            background: rgba(0,0,0,0.35);        }        .account-banner .container {            position: relative;            z-index: 2;        }    .content-title-heading {        margin-bottom: 15px;    }    .text-title-heading {        color: #fff;        font-size: 52px;        font-weight: 700;        margin-bottom: 15px;        text-align: center;    }    #breadcrumb,    #breadcrumb a,    #breadcrumb .current {        color: #fff;        font-size: 16px;        text-align: center;    }</style><div class="account-banner" style="margin-bottom: 100px">    <div class="container">        <div class="content-title-heading">            <h1 class="text-title-heading">                Bouquet            </h1>        </div><!-- Page Title -->    </div></div><div id="primary" class="content-area">    <main id="main" class="site-main" role="main">        <div class="sidebar  shop-layout-boxed">            <div class="remove-sidebar"></div>            <div class="container">                <div class="main-archive-product row">                    <div class="bwp-sidebar sidebar-product col-xl-3 col-lg-3 col-md-12 col-12">                        <div class="button-filter-toggle hidden-lg hidden-md">                            <div class="filter-close">                            </div>                        </div>                        <aside id="bwp_ajax_filte-8" class="widget bwp_ajax_filte">                            <div id="bwp_filter_ajax9579302141778916052" class="bwp-woocommerce-filter-product">                                <!-- SECTION: CATEGORIES -->                                <div class="widget bwp-filter bwp-filter-category">                                    <h3 class="widget-title">Occassions</h3>                                    <div id="pa_category" data-taxonomy="product_cat" class="block_content filter_taxonomy_product filter_category_product">                                        <div data-id_item="568" class="item-taxonomy item-category">                                            <a href="@Url.Action("Index", "Shop")">                                                <label class="name">All Occassions</label>                                                <label class="count"></label>                                            </a>                                        </div>                                        @foreach (var occasion in Model.Occasions)                                        {                                            var isActive = Model.SelectedOccasionId == occasion.Id;                                            <div data-id_item="568" class="item-taxonomy item-category" @(isActive ? "bg-light" : "")">                                                <a href="@Url.Action("Index", "Shop", new { occasionId = occasion.Id })">                                                    <label class="name">@occasion.Name</label>                                                    <label class="count"></label>                                                </a>                                            </div>                                        }                                    </div>                                </div>                            </div>                        </aside>                    </div>                    <div class="col-xl-9 col-lg-9 col-md-12 col-12">                        <div class="content-products-list">                            <ul class="products products-list row grid" data-col="col-lg-3 col-md-4 col-sm-4 col-6">                                @foreach (var b in Model.Bouquets)                                {                                    <li class="col-lg-3 col-md-4 col-sm-4 col-6 post-16508 product type-product status-publish has-post-thumbnail product_brand-katie product_cat-anniversary product_cat-seasonal-flowers product_tag-hot product_tag-trend first instock featured shipping-taxable product-type-external">                                        <div class="products-entry content-product4 clearfix product-wapper">                                            @{                                                // Mặc định ban đầu nếu không có ảnh hoặc dữ liệu lỗi                                                var img1 = "/images/default-flower.jpg";                                                var img2 = "/images/default-flower.jpg";                                                if (!string.IsNullOrEmpty(b.ImageUrl))                                                {                                                    // Tách chuỗi ảnh chứa dấu phẩy thành mảng các đường dẫn độc lập                                                    string[] imageList = b.ImageUrl.Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries);                                                    if (imageList.Length > 0)                                                    {                                                        img1 = imageList[0].Trim();                                                        img2 = img1; // Nếu chỉ có 1 ảnh thì ảnh hover trùng ảnh chính                                                    }                                                    if (imageList.Length > 1)                                                    {                                                        img2 = imageList[1].Trim(); // Nếu có từ 2 ảnh trở lên, lấy ảnh thứ 2 làm ảnh hover                                                    }                                                }                                            }                                            <div class="products-thumb">                                                <div class="product-thumb-img">                                                    <div class="product-thumb-hover">                                                        <a asp-controller="Shop" asp-action="Detail" asp-route-id="@b.Id" class="woocommerce-LoopProduct-link">                                                            <img decoding="async" src="@img1" class="fade-in wp-post-image ls-is-cached lazyloaded" alt="@b.Name" loading="eager" style="width: 100%; height: 320px; object-fit: cover;" />                                                            <img decoding="async" src="@img2" class="hover-image back" alt="@b.Name" loading="eager" style="width: 100%; height: 320px; object-fit: cover;" />                                                        </a>                                                    </div>                                                </div>                                                <div class="product-button tooltip">                                                    <span class="product-quickview" data-title="View">                                                        <a asp-controller="Shop" asp-action="Detail" asp-route-id="@b.Id" class="">                                                            <span>View</span>                                                        </a>                                                    </span>                                                </div>                                                <div class="btn-atc hidden-md hidden-sm hidden-xs">                                                    <div class="type_external" data-title="Buy on Amazon">                                                        <a rel="nofollow" href="#"                                                        onclick="document.getElementById('cart-form-@b.Id').submit(); return false;" data-product_id="@b.Id" class="button product_type_external read_more">                                                            <span>Add to cart</span></a>                                                        <form id="cart-form-@b.Id" asp-controller="Cart" asp-action="AddToCart" method="post" style="display:none">                                                            <input type="hidden" name="bouquetId" value="@b.Id" />                                                            <input type="hidden" name="quantity" value="1" />                                                        </form>                                                    </div>                                                </div>                                                <div class="product-button-mobile">                                                    <div class="woosw-wishlist" data-title="Wishlist">                                                        <button class="woosw-btn woosw-btn-@b.Id" data-id="@b.Id">Add to wishlist</button>                                                    </div>                                                    <span class="product-quickview" data-title="Quick View">                                                        <a href="#" data-product_id="@b.Id" class="quickview quickview-button quickview-@b.Id"><span>Quick View</span></a>                                                    </span>                                                </div>                                            </div>                                            <div class="products-content">                                                <div class="contents">                                                    <h3 class="product-title">                                                        <a href="#">@b.Name</a>                                                    </h3>                                                    <span class="price">                                                        <span class="woocommerce-Price-amount amount">                                                            <bdi>                                                                <span class="woocommerce-Price-currencySymbol">$</span>@b.Price                                                            </bdi>                                                        </span>                                                    </span>                                                </div>                                            </div>                                        </div>                                    </li>                                }                            </ul>                        </div>                        <div class="bwp-top-bar bottom clearfix">                            <nav class="woocommerce-pagination">    <ul class="page-numbers">        <li>            @if (Model.CurrentPage > 1)            {                <a class="prev page-numbers" href="@Url.Action("Index", "Shop", new { occasionId = Model.SelectedOccasionId, page = Model.CurrentPage - 1, pageSize = Model.PageSize })">Prev</a>            }            else            {                @* Nếu đang ở trang 1, biến thành thẻ span và thêm style chặn click, làm mờ nút *@                <span class="prev page-numbers disabled" style="color: #ccc; cursor: not-allowed; pointer-events: none;">Prev</span>            }        </li>        @for (var i = 1; i <= Model.TotalPages; i++)        {            if (i == Model.CurrentPage)            {                <li>                    <span aria-label="Page @i" aria-current="page" class="page-numbers current">@i</span>                </li>            }            else            {                <li>                    <a aria-label="Page @i" class="page-numbers" href="@Url.Action("Index", "Shop", new { occasionId = Model.SelectedOccasionId, page = i, pageSize = Model.PageSize })">@i</a>                </li>            }        }        <li>            @if (Model.CurrentPage < Model.TotalPages)            {                <a class="next page-numbers" href="@Url.Action("Index", "Shop", new { occasionId = Model.SelectedOccasionId, page = Model.CurrentPage + 1, pageSize = Model.PageSize })">Next</a>            }            else            {                @* Nếu đang ở trang cuối cùng, biến thành thẻ span và chặn mọi hành vi click *@                <span class="next page-numbers disabled" style="color: #ccc; cursor: not-allowed; pointer-events: none;">Next</span>            }        </li>    </ul></nav>                        </div>                    </div>                </div>            </div>        </div>    </main></div>
@model Shopv2.Models.ViewModels.ShopIndexViewModel@using System.Globalization@{    ViewData["Title"] = "Shop Bouquets";    // Hàm format giá tiền    string PriceDisplay(decimal price) => price.ToString("C", CultureInfo.CurrentCulture);}<div id="primary" class="content-area">    <main id="main" class="site-main" role="main">        <div class="sidebar  shop-layout-boxed">            <div class="remove-sidebar"></div>            <div class="container">                <div class="main-archive-product row">                    <div class="bwp-sidebar sidebar-product col-xl-3 col-lg-3 col-md-12 col-12">                        <div class="button-filter-toggle hidden-lg hidden-md">                            <div class="filter-close">                            </div>                        </div>                        <aside id="bwp_ajax_filte-8" class="widget bwp_ajax_filte">                            <div id="bwp_filter_ajax9579302141778916052" class="bwp-woocommerce-filter-product">                                <!-- SECTION: CATEGORIES -->                                <div class="widget bwp-filter bwp-filter-category">                                    <h3 class="widget-title">Categories</h3>                                    <div id="pa_category" data-taxonomy="product_cat" class="block_content filter_taxonomy_product filter_category_product">                                        @foreach (var occasion in Model.Occasions)                                        {                                            var isActive = Model.SelectedOccasionId == occasion.Id;                                            <div data-id_item="568" class="item-taxonomy item-category" @(isActive ? "bg-light" : "")">                                                <a href="@Url.Action("Index", "Shop", new { occasionId = occasion.Id })">                                                    <label class="name">@occasion.Name</label>                                                    <label class="count"></label>                                                </a>                                            </div>                                        }                                    </div>                                </div>                            </div>                        </aside>                    </div>                    <div class="col-xl-9 col-lg-9 col-md-12 col-12">                        <div class="content-products-list">                            <ul class="products products-list row grid" data-col="col-lg-3 col-md-4 col-sm-4 col-6">                                @foreach (var b in Model.Bouquets)                                {                                    <li class="col-lg-3 col-md-4 col-sm-4 col-6 post-16508 product type-product status-publish has-post-thumbnail product_brand-katie product_cat-anniversary product_cat-seasonal-flowers product_tag-hot product_tag-trend first instock featured shipping-taxable product-type-external">                                        <div class="products-entry content-product4 clearfix product-wapper">                                            <div class="products-thumb">                                                <div class="product-lable">                                                    <div class="vgwc-label vgwc-featured hot">Hot</div>                                                </div>                                                <div class="product-thumb-img">                                                    <div class="product-thumb-hover">                                                        <a href="the-athena/index.html" class="woocommerce-LoopProduct-link">                                                            <img width="600" height="750" src="@b.ImageUrl" class="fade-in wp-post-image ls-is-cached lazyloaded" alt="" loading="eager" decoding="async">                                                            <img width="600" height="750" src="../wp-content/uploads/2020/12/product-22-600x750.jpg" class="hover-image back" alt="" loading="eager" decoding="async">                                                        </a>                                                    </div>                                                </div>                                                <div class="product-button tooltip">                                                    <span class="product-quickview" data-title="Quick View">                                                        <a asp-controller="Shop" asp-action="Detail" asp-route-id="@b.Id" class="quickview quickview-button">                                                            <span>Quick View</span>                                                        </a>                                                    </span>                                                    <div class="woosw-wishlist" data-title="Wishlist">                                                        <button class="woosw-btn woosw-btn-16508" data-id="16508">Add to wishlist</button>                                                    </div>                                                    <div class="woosc-compare" data-title="Compare">                                                        <button class="woosc-btn woosc-btn-16508 " data-id="16508">Compare</button>                                                    </div>                                                </div>                                                <div class="btn-atc hidden-md hidden-sm hidden-xs">                                                    <div class="type_external" data-title="Buy on Amazon">                                                        <a rel="nofollow" href="https://www.amazon.com/" data-quantity="1" data-product_id="16508" data-product_sku="D2300" class="button product_type_external read_more"><span>Buy on Amazon</span></a>                                                    </div>                                                </div>                                                <div class="product-button-mobile">                                                    <div class="woosw-wishlist" data-title="Wishlist">                                                        <button class="woosw-btn woosw-btn-16508" data-id="16508">Add to wishlist</button>                                                    </div>                                                    <span class="product-quickview" data-title="Quick View">                                                        <a href="#" data-product_id="16508" class="quickview quickview-button quickview-16508"><span>Quick View</span></a>                                                    </span>                                                </div>                                            </div>                                            <div class="products-content">                                                <div class="contents">                                                    <h3 class="product-title">                                                        <a href="the-athena/index.html">@b.Name</a>                                                    </h3>                                                    <span class="price">                                                        <span class="woocommerce-Price-amount amount">                                                            <bdi>                                                                <span class="woocommerce-Price-currencySymbol">$</span>100.00                                                            </bdi>                                                        </span>                                                    </span>                                                </div>                                            </div>                                        </div>                                    </li>                                }                            </ul>                        </div>                        <div class="bwp-top-bar bottom clearfix">                            <nav class="woocommerce-pagination">                                <ul class="page-numbers">                                    @if (Model.CurrentPage > 1)                                    {                                        <li>                                            <a class="prev page-numbers" href="@Url.Action("Index", "Shop", new { occasionId = Model.SelectedOccasionId, page = Model.CurrentPage - 1, pageSize = Model.PageSize })">Prev</a>                                        </li>                                    }                                    @for (var i = 1; i <= Model.TotalPages; i++)                                    {                                        if (i == Model.CurrentPage)                                        {                                            <li>                                                <span aria-label="Page @i" aria-current="page" class="page-numbers current">@i</span>                                            </li>                                        }                                        else                                        {                                            <li>                                                <a aria-label="Page @i" class="page-numbers" href="@Url.Action("Index", "Shop", new { occasionId = Model.SelectedOccasionId, page = i, pageSize = Model.PageSize })">@i</a>                                            </li>                                        }                                    }                                    @if (Model.CurrentPage < Model.TotalPages)                                    {                                        <li>                                            <a class="next page-numbers" href="@Url.Action("Index", "Shop", new { occasionId = Model.SelectedOccasionId, page = Model.CurrentPage + 1, pageSize = Model.PageSize })">Next</a>                                        </li>                                    }                                </ul>                            </nav>                        </div>                    </div>                </div>            </div>        </div>    </main></div>
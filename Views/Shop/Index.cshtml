@model Shopv2.Models.ViewModels.ShopIndexViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Shop Bouquets";

    // Hàm format giá tiền
    string PriceDisplay(decimal price) => price.ToString("C", CultureInfo.CurrentCulture);
}

<section class="container my-4">
    <div class="row">
        <aside class="col-md-3 mb-4">
            <div class="card">
                <div class="card-header">
                    <strong>Occasions</strong>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item @(Model.SelectedOccasionId == null ? "bg-light" : "")">
                        <a href="@Url.Action("Index", "Shop")" class="@(Model.SelectedOccasionId == null ? "fw-bold text-dark" : "")">All Bouquets</a>
                    </li>
                    @foreach (var occasion in Model.Occasions)
                    {
                        var isActive = Model.SelectedOccasionId == occasion.Id;
                        <li class="list-group-item @(isActive ? "bg-light" : "")">
                            <a href="@Url.Action("Index", "Shop", new { occasionId = occasion.Id })"
                               class="@(isActive ? "fw-bold text-dark" : "")">
                                @occasion.Name
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </aside>

        <main class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Bouquets</h2>
                <small class="text-muted">Showing page @Model.CurrentPage of @Model.TotalPages</small>
            </div>

            @if (!Model.Bouquets.Any())
            {
                <div class="alert alert-info">No bouquets found.</div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var b in Model.Bouquets)
                    {
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="card h-100">
                                @if (!string.IsNullOrEmpty(b.ImageUrl))
                                {
                                    <img src="@b.ImageUrl" class="card-img-top" alt="@b.Name" style="object-fit:cover; height:180px;">
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center" style="height:180px;">
                                        <span class="text-muted">No image</span>
                                    </div>
                                }

                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title mb-1">@b.Name</h5>
                                    @if (!string.IsNullOrWhiteSpace(b.Description))
                                    {
                                        <p class="card-text text-muted small mb-2">@b.Description</p>
                                    }
                                    <div class="mt-auto d-flex justify-content-between align-items-center">
                                        <strong class="text-primary">@PriceDisplay(b.Price)</strong>
                                        <div>
                                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", "Shop", new { id = b.Id })">View</a>
                                            <a class="btn btn-sm btn-success" href="@Url.Action("AddToCart", "Cart", new { bouquetId = b.Id })">Add</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <nav class="mt-4" aria-label="Bouquet pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Shop", new { occasionId = Model.SelectedOccasionId, page = Model.CurrentPage - 1, pageSize = Model.PageSize })" aria-label="Previous">Previous</a>
                        </li>

                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", "Shop", new { occasionId = Model.SelectedOccasionId, page = i, pageSize = Model.PageSize })">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Shop", new { occasionId = Model.SelectedOccasionId, page = Model.CurrentPage + 1, pageSize = Model.PageSize })" aria-label="Next">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </main>
    </div>
</section>
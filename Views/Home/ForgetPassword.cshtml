@model Shopv2.Models.ViewModels.ForgetPasswordViewModel

@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = "Quên mật khẩu";
}
<style>
    .account-banner {
        background-image: url('/client/wp-content/themes/floomi/assets/images/bg-breadcrumb.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        padding: 120px 0;
        position: relative;
    }

        .account-banner::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.35);
        }

        .account-banner .container {
            position: relative;
            z-index: 2;
        }

    .content-title-heading {
        margin-bottom: 15px;
    }

    .back-to-shop {
        display: inline-block;
        background: #c8a96a;
        color: #fff;
        padding: 6px 12px;
        font-size: 14px;
        margin-bottom: 15px;
    }

    .text-title-heading {
        color: #fff;
        font-size: 52px;
        font-weight: 700;
        margin-bottom: 15px;
        text-align: center;
    }

    #breadcrumb,
    #breadcrumb a,
    #breadcrumb .current {
        color: #fff;
        font-size: 16px;
        text-align: center;
    }

    .forgot-password-wrapper {
        padding: 80px 0;
        background: #f8f8f8;
    }

    .lost_reset_password {
        max-width: 650px;
        margin: auto;
        background: #fff;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.08);
    }

        .lost_reset_password p {
            margin-bottom: 20px;
        }

        .lost_reset_password label {
            font-weight: 600;
            margin-bottom: 10px;
            display: block;
            color: #222;
        }

        .lost_reset_password .input-text {
            width: 100%;
            height: 55px;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 0 18px;
            font-size: 16px;
            transition: all .3s ease;
            background: #fff;
        }

            .lost_reset_password .input-text:focus {
                border-color: #c8a96a;
                outline: none;
                box-shadow: 0 0 0 3px rgba(200,169,106,0.15);
            }

        .lost_reset_password .button {
            background: #c8a96a !important;
            color: #fff !important;
            border: none !important;
            height: 52px;
            padding: 0 30px;
            border-radius: 999px;
            font-weight: 600;
            text-transform: uppercase;
            transition: all .3s ease;
            cursor: pointer;
        }

            .lost_reset_password .button:hover {
                background: #111 !important;
            }

    .text-danger ul {
        padding-left: 20px;
        margin-top: 10px;
    }

    .text-danger li {
        color: #dc3545;
    }

    @@media(max-width:768px) {
        .account-banner {
            padding: 80px 0;
        }

        .text-title-heading {
            font-size: 36px;
        }

        .lost_reset_password {
            padding: 25px;
        }
    }
</style>

<div id="bwp-main" class="bwp-main">
    <div class="account-banner">
				<div class="container" >	
										<div class="content-title-heading">
		@* <span class="back-to-shop">Shop</span> *@
		<h1 class="text-title-heading">
			My Account		</h1>
	</div><!-- Page Title -->
            <div id="breadcrumb" class="breadcrumb"><div class="bwp-breadcrumb"><a asp-action="Index">Home</a> <span class="delimiter">/</span> <span class="current">My Account</span> </div></div>
        </div>
			</div><!-- .container -->
    <div class="forgot-password-wrapper">
			<div class="container">
	<div class="row">
		<div class="col-lg-12 col-md-12">    
			<div id="main-content" class="main-content">
				<div id="primary" class="content-area">
					<div id="content" class="site-content" role="main">
						<article id="post-19" class="post-19 page type-page status-publish hentry">
		<div class="entry-content clearfix">
		<div class="woocommerce"><div class="woocommerce-notices-wrapper"></div>
<form method="post" 
	asp-controller="Home"
    asp-action="ForgetPassword"
	class="woocommerce-ResetPassword lost_reset_password">

	<p>Lost your password? Please enter your username or email address. You will receive a link to create a new password via email.</p>
	<p class="woocommerce-form-row woocommerce-form-row--first form-row form-row-first">
		<label for="user_login">Username or email&nbsp;<span class="required" aria-hidden="true">*</span><span class="screen-reader-text">Required</span></label>
		<input asp-for="Email" class="woocommerce-Input woocommerce-Input--text input-text" type="text"  id="" autocomplete="username" aria-required="true" />
	</p>

	<div class="clear"></div>
    <div asp-validation-summary="All" class="text-danger"></div>

	
	<p class="woocommerce-form-row form-row">
		<input type="hidden" name="wc_reset_password" value="true" />
		<button type="submit" class="woocommerce-Button button" value="Reset password">Reset password</button>
	</p>

	<input type="hidden" id="woocommerce-lost-password-nonce" name="woocommerce-lost-password-nonce" value="ec39e53abf" /><input type="hidden" name="_wp_http_referer" value="/my-account/lost-password/" />
</form>
</div>
	</div><!-- .entry-content -->
</article><!-- #post-## -->					</div><!-- #content -->
				</div><!-- #primary -->
			</div><!-- #main-content -->
		</div>   
    </div>
</div> </div>
	</div>
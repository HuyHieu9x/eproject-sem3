@model Shopv2.Models.ViewModels.RegisterViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<style>
	.orderby {
		height: 45px !important;
		/* padding: 0 15px !important; */
		border: 1px solid #ccc !important;
	}

	#dob {
		width: 100%;
		height: 45px;
		/* padding: 0 15px; */
		border: 1px solid #ccc;
		border-radius: 5px;
		font-size: 14px;
	}

		#dob:focus {
			outline: none;
			border-color: #ff6b81;
		}

	.woocommerce-form {
		width: 50%;
		/* margin: 0 auto; */
	}

	.woocommerce-form-row input,
	.woocommerce-form-row select {
		width: 100% !important;
	}

    .text-danger,
    .field-validation-error {
        color: #ff4d4f;
        font-size: 13px;
        margin-top: 5px;
        display: block;
    }

    .input-validation-error {
        border: 1px solid #ff4d4f !important;
        background-color: #fff2f0;
    }

    .validation-summary-errors {
        color: #ff4d4f;
        background: #fff2f0;
        padding: 10px;
        border-radius: 5px;
        margin-bottom: 15px;
    }
</style>

<div class="mkdf-full-width-inner">
	<div class="mkdf-grid-row">
		<div class="mkdf-page-content-holder mkdf-grid-col-12">
			<section class="wpb-content-wrapper">
				<div class="mkdf-row-grid-section-wrapper ">
					<div class="mkdf-row-grid-section">
						<div class="vc_row wpb_row vc_row-fluid vc_custom_1519048622969">
							<div class="wpb_column vc_column_container vc_col-sm-12">
								<div class="vc_column-inner">
									<div class="wpb_wrapper">
										<div class="woocommerce">
											<div class="woocommerce-notices-wrapper"></div>

											<h2>Register</h2>

                                            <form asp-action="Register" method="post" class="woocommerce-form">

                                                <div asp-validation-summary="All" class="text-danger"></div>

                                                <p class="form-row">
                                                    <label>First Name *</label>
                                                    <input asp-for="FirstName" class="input-text" />
                                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                                </p>

                                                <p class="form-row">
                                                    <label>Last Name *</label>
                                                    <input asp-for="LastName" class="input-text" />
                                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                                </p>

                                                <p class="form-row">
                                                    <label>Email *</label>
                                                    <input asp-for="Username" class="input-text" />
                                                    <span asp-validation-for="Username" class="text-danger"></span>
                                                </p>

                                                <p class="form-row">
                                                    <label>Password *</label>
                                                    <input asp-for="Password" type="password" class="input-text" />
                                                    <span asp-validation-for="Password" class="text-danger"></span>
                                                </p>

                                                <p class="form-row">
                                                    <label>Date Of Birth *</label>
                                                    <input asp-for="Dob" type="date" class="input-text orderby" id="dob" />
                                                    <span asp-validation-for="Dob" class="text-danger"></span>
                                                </p>

                                                <p class="form-row">
                                                    <label>Gender *</label>

                                                    <div style="">
                                                        <select class="orderby" data-val="true" data-val-required="Gender is required" id="Gender" name="Gender">
                                                            <option value="">-- Select Gender --</option>
                                                            <option value="1">Female</option>
                                                            <option value="0">Male</option>
                                                        </select>
                                                    </div>

                                                    <span asp-validation-for="Gender" class="text-danger"></span>
                                                </p>

                                                <p class="form-row">
                                                    <label>Phone *</label>
                                                    <input asp-for="Phone" class="input-text" />
                                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                                </p>

                                                <p class="form-row">
                                                    <label>Address *</label>
                                                    <input asp-for="Address" class="input-text" />
                                                    <span asp-validation-for="Address" class="text-danger"></span>
                                                </p>

                                                <button type="submit"
                                                        class="woocommerce-button button">
                                                    Register
                                                </button>

                                            </form>


										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
		</div>
	</div>
</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
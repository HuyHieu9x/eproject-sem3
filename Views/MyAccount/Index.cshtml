@model Shopv2.Models.ViewModels.AdminLoginViewModel;
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<style>
    .text-danger,
    .field-validation-error {
        color: red;
        font-size: 13px;
        display: block;
        margin-top: 5px;
    }

    .input-validation-error {
        border: 1px solid red !important;
    }
	.woocommerce-form {
		width: 50%;
		margin: 0 auto;
	}

	.woocommerce-form-row input,
	.woocommerce-form-row select {
		width: 100% !important;
	}
</style>

<div class="mkdf-full-width-inner">
	<div class="mkdf-grid-row">
		<div class="mkdf-page-content-holder mkdf-grid-col-12">
			<section class="wpb-content-wrapper">
				<div class="mkdf-row-grid-section-wrapper ">
					<div class="mkdf-row-grid-section">
						<div class="vc_row wpb_row vc_row-fluid vc_custom_1519048622969">
							<div class="wpb_column vc_column_container vc_col-sm-12">
								<div class="vc_column-inner">
									<div class="wpb_wrapper">
										<div class="woocommerce">
											<div class="woocommerce-notices-wrapper"></div>

											<h2>Login</h2>

                                            <form asp-action="Index"
                                                  method="post"
                                                  class="woocommerce-form woocommerce-form-login login">

                                                <div asp-validation-summary="All"
                                                     class="text-danger">
                                                </div>

                                                <p class="woocommerce-form-row woocommerce-form-row--wide form-row form-row-wide">

                                                    <label asp-for="Email">
                                                        Username or email address
                                                        <span class="required">*</span>
                                                    </label>

                                                    <input asp-for="Email"
                                                           class="woocommerce-Input woocommerce-Input--text input-text"
                                                           autocomplete="username" />

                                                    <span asp-validation-for="Email"
                                                          class="text-danger">
                                                    </span>

                                                </p>

                                                <p class="woocommerce-form-row woocommerce-form-row--wide form-row form-row-wide">

                                                    <label asp-for="Password">
                                                        Password
                                                        <span class="required">*</span>
                                                    </label>

                                                    <input asp-for="Password"
                                                           type="password"
                                                           class="woocommerce-Input woocommerce-Input--text input-text"
                                                           autocomplete="current-password" />

                                                    <span asp-validation-for="Password"
                                                          class="text-danger">
                                                    </span>

                                                </p>

                                                <p class="form-row">

                                                    <label class="woocommerce-form__label woocommerce-form__label-for-checkbox woocommerce-form-login__rememberme">

                                                        <input asp-for="RememberMe"
                                                               class="woocommerce-form__input woocommerce-form__input-checkbox" />

                                                        <span>Remember me</span>

                                                    </label>

                                                    <button type="submit"
                                                            class="woocommerce-button button woocommerce-form-login__submit">
                                                        Log in
                                                    </button>

                                                </p>

                                                <p class="woocommerce-LostPassword lost_password">
                                                    <a href="/my-account/forget-password">Lost your password?</a>
                                                </p>

                                                <p class="woocommerce-LostPassword lost_password">
                                                    <a href="/my-account/register">Register</a>
                                                </p>

                                            </form>


										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
		</div>
	</div>
</div>

@section Scripts{

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}v
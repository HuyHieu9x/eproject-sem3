@model Shopv2.Models.Bouquet
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm Bó Hoa";
}

<section class="content pt-4">
    <div class="container-fluid">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">Thêm Sản Phẩm Hoa Mới</h3>
            </div>
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="card-body">
                    <div class="form-group">
                        <label for="Name">Tên Bó Hoa</label>
                        <input type="text" asp-for="Name" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="OccasionId">Thuộc Dịp Lễ</label>
                        <select asp-for="OccasionId" class="form-control" asp-items="ViewBag.OccasionId" required></select>
                    </div>
                    <div class="form-group">
                        <label for="Price">Giá tiền (đ)</label>
                        <input type="number" asp-for="Price" class="form-control" value="0" required>
                    </div>

                    <!-- SỬA DÒNG NÀY: Thay asp-for="ImageUrl" bằng asp-for="ImageFile" -->
                    <div class="form-group">
                        <label>Tải lên hình ảnh sản phẩm (Có thể chọn nhiều ảnh)</label>
                        <!-- THÊM thuộc tính multiple và ĐỔI tên thành ImageFiles -->
                        <input type="file" name="ImageFiles" class="form-control-file" accept="image/*" multiple />
                    </div>

                    <div class="form-group">
                        <label for="Description">Mô tả sản phẩm</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group form-check">
                        <input type="checkbox" asp-for="IsActive" class="form-check-input" checked>
                        <label class="form-check-label" for="IsActive">Kích hoạt hiển thị công khai</label>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Lưu sản phẩm</button>
                    <a asp-action="Index" class="btn btn-default">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</section>
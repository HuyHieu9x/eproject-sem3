@model IEnumerable<Shopv2.Models.Bouquet>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Bó Hoa";
    var occasionsDict = ViewBag.Occasions as Dictionary<int, string>;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Quản lý Bó Hoa</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Thêm Bó Hoa Mới</a>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-striped align-middle">
                    <thead>
                        <tr>
                            <th style="width: 5%">ID</th>
                            <th style="width: 10%">Hình ảnh</th>
                            <th>Tên Bó Hoa</th>
                            <th>Giá tiền</th>
                            <th>Dịp Lễ</th>
                            <th>Trạng thái</th>
                            <th style="width: 18%">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" style="width: 60px; height: 60px; object-fit: cover;" class="img-thumbnail" />
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">No img</span>
                                    }
                                </td>
                                <td>@item.Name</td>
                                <td>@item.Price.ToString("N0") đ</td>
                                <td>@(occasionsDict != null && occasionsDict.ContainsKey(item.OccasionId) ? occasionsDict[item.OccasionId] : item.OccasionId)</td>
                                <td>
                                    <span class="badge @(item.IsActive ? "badge-success" : "badge-danger")">
                                        @(item.IsActive ? "Đang bán" : "Ẩn")
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bạn muốn xóa bó hoa này?')"><i class="fas fa-trash"></i> Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
@model IEnumerable<Shopv2.Models.Message>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Lời Chúc";
    var occasionsDict = ViewBag.Occasions as Dictionary<int, string>;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Quản lý Lời Chúc / Thông Điệp</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Thêm Lời Chúc Mới</a>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 10%">ID</th>
                            <th style="width: 25%">Thuộc Dịp Lễ</th>
                            <th>Nội Dung Lời Chúc</th>
                            <th style="width: 20%">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>
                                    @(occasionsDict != null && occasionsDict.ContainsKey(item.OccasionId)
                                                                    ? occasionsDict[item.OccasionId] : $"Dịp lễ #{item.OccasionId}")
                            </td>
                            <td>@item.Content</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa lời chúc này?')"><i class="fas fa-trash"></i> Xóa</a>
                            </td>
                        </tr>
                                                }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
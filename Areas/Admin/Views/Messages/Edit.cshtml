@model Shopv2.Models.Message
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Update Message";
}

<section class="content pt-4">
    <div class="container-fluid">
        <div class="card card-warning">
            <div class="card-header">
                <h3 class="card-title">Edit Message</h3>
            </div>

            <form asp-action="Edit" method="post" id="messageForm" novalidate>
                <input type="hidden" asp-for="Id" />

                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert" style="display:none;" id="validationSummaryAlert">
                        <i class="icon fas fa-exclamation-triangle"></i>
                        Please fill in all required fields before updating.
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>

                    <div class="form-group">
                        <label>Editing Message ID: @Model.Id</label>
                    </div>

                    <div class="form-group">
                        <label for="OccasionId">Change Occasion</label>
                        <select asp-for="OccasionId" class="form-control" asp-items="ViewBag.OccasionId" required>
                            <option value="">-- Select an occasion --</option>
                        </select>
                        <span asp-validation-for="OccasionId" class="text-danger text-sm"></span>
                    </div>

                    <div class="form-group">
                        <label for="Content">Message Content</label>
                        <textarea asp-for="Content" class="form-control" rows="4" required></textarea>
                        <span asp-validation-for="Content" class="text-danger text-sm"></span>
                    </div>
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-warning">Update</button>
                    <a asp-action="Index" class="btn btn-default">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/admin/plugins/jquery-validation/jquery.validate.min.js"></script>

    <script>
        $(document).ready(function () {
            var form = $('#messageForm');

            form.on('submit', function (e) {
                var formElement = form[0];

                // If any field fails validation constraints
                if (!formElement.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();

                    $('#validationSummaryAlert').fadeIn();

                    // Loop through all inputs to instantly toggle red error highlight states
                    form.find('.form-control').each(function () {
                        if (!this.checkValidity()) {
                            $(this).addClass('is-invalid'); // Turns input border red
                        } else {
                            $(this).removeClass('is-invalid');
                        }
                    });
                }

                form.addClass('was-validated');
            });

            // Real-time tracking: Strip off red borders immediately as the user types/updates fields
            form.find('.form-control').on('input change', function () {
                if (this.checkValidity()) {
                    $(this).removeClass('is-invalid');
                } else {
                    $(this).addClass('is-invalid');
                }

                // Smoothly dismiss the top alert banner once the whole configuration passes validity tests
                if (form[0].checkValidity()) {
                    $('#validationSummaryAlert').fadeOut();
                }
            });
        });
    </script>
}
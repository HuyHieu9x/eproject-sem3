@model IEnumerable<Shopv2.Models.Bouquet>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Bouquets Management";
    var occasionsDict = ViewBag.Occasions as Dictionary<int, string>;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string currentFilter = ViewBag.CurrentFilter as string;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Manage Bouquets</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @if (TempData["AlertMessage"] != null)
        {
            <div class="alert alert-@TempData["AlertType"] alert-dismissible fade show" role="alert">
                <i class="icon fas @(TempData["AlertType"]?.ToString() == "success" ? "fa-check-circle" : "fa-exclamation-triangle")"></i>
                @TempData["AlertMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-4">
                        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Add New Bouquet</a>
                    </div>
                    <div class="col-md-8">
                        <form asp-action="Index" method="get" class="form-inline float-md-right mt-2 mt-md-0">
                            <div class="input-group input-group-sm">
                                <input type="text" name="searchString" class="form-control" placeholder="Search bouquet name..." value="@currentFilter" />
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-default">
                                        <i class="fas fa-search"></i> Search
                                    </button>
                                    @if (!string.IsNullOrEmpty(currentFilter))
                                    {
                                        <a asp-action="Index" class="btn btn-secondary btn-sm">Clear Filter</a>
                                    }
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <table class="table table-bordered table-striped align-middle">
                    <thead>
                        <tr>
                            <th style="width: 5%">ID</th>
                            <th style="width: 10%">Image</th>
                            <th>Bouquet Name</th>
                            <th>Price</th>
                            <th>Occasion</th>
                            <th>Status</th>
                            <th style="width: 18%">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            var firstImage = item.ImageUrl.Split(',')[0];
                                            <img src="@firstImage" alt="Cover" style="width: 100px; height: 60px;" class="img-thumbnail" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">No Image</span>
                                        }
                                    </td>
                                    <td>@item.Name</td>
                                    <td>@item.Price.ToString("N0") USD</td>
                                    <td>
                                        @(occasionsDict != null && occasionsDict.ContainsKey(item.OccasionId) ? occasionsDict[item.OccasionId] : "Unassigned")
                                    </td>
                                    <td>
                                        <span class="badge @(item.IsActive ? "badge-success" : "badge-danger")">
                                            @(item.IsActive ? "Active" : "Hidden")
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this bouquet?')"><i class="fas fa-trash"></i> Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center">No matching bouquet records found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer clearfix">
                <ul class="pagination pagination-sm m-0 float-right">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@currentFilter">&laquo;</a>
                    </li>

                    @if (totalPages <= 1)
                    {
                        <li class="page-item active">
                            <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-searchString="@currentFilter">1</a>
                        </li>
                    }
                    else
                    {
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@currentFilter">@i</a>
                            </li>
                        }
                    }

                    <li class="page-item @(currentPage == totalPages || totalPages <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@currentFilter">&raquo;</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>
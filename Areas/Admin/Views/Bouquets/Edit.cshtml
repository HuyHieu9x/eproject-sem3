@model Shopv2.Models.Bouquet
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Bouquet";
}

<section class="content pt-4">
    <div class="container-fluid">
        <div class="card card-warning">
            <div class="card-header">
                <h3 class="card-title">Modify Bouquet Information</h3>
            </div>
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <div class="card-body">
                    <div class="form-group">
                        <label for="Name">Bouquet Name</label>
                        <input type="text" asp-for="Name" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="OccasionId">Target Occasion</label>
                        <select asp-for="OccasionId" class="form-control" asp-items="ViewBag.OccasionId" required></select>
                    </div>
                    <div class="form-group">
                        <label for="Price">Price (USD)</label>
                        <input type="number" asp-for="Price" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Current Uploaded Images</label>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                var images = Model.ImageUrl.Split(',');
                                foreach (var imgUrl in images)
                                {
                                    <img src="@imgUrl" alt="Product attachment" class="img-thumbnail mr-2" style="max-width: 100px; max-height: 100px;" />
                                }
                            }
                            else
                            {
                                <span class="text-muted">No images attached to this entry</span>
                            }
                        </div>
                        <label for="ImageFiles">Select new configuration batch to override image array (Leave blank to preserve current layout)</label>
                        <input type="file" name="ImageFiles" class="form-control-file" accept="image/*" multiple>
                    </div>
                    <div class="form-group">
                        <label for="Description">Product Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group form-check">
                        <input type="checkbox" asp-for="IsActive" class="form-check-input">
                        <label class="form-check-label" for="IsActive">Publish publicly on storefront</label>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-warning">Update Product</button>
                    <a asp-action="Index" class="btn btn-default">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</section>
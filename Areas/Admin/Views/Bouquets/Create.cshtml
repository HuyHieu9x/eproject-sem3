@model Shopv2.Models.Bouquet
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Bouquet";
}

<section class="content pt-4">
    <div class="container-fluid">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">Add New Bouquet Product</h3>
            </div>

            <form asp-action="Create" method="post" enctype="multipart/form-data" id="bouquetForm" novalidate>
                <div class="card-body">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert" style="display:none;" id="validationSummaryAlert">
                        <i class="icon fas fa-exclamation-triangle"></i>
                        Please fill in all required fields and upload at least one image before saving.
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>

                    <div class="form-group">
                        <label for="Name">Bouquet Name</label>
                        <input type="text" asp-for="Name" class="form-control" required>
                        <span asp-validation-for="Name" class="text-danger text-sm"></span>
                    </div>

                    <div class="form-group">
                        <label for="OccasionId">Target Occasion</label>
                        <select asp-for="OccasionId" class="form-control" asp-items="ViewBag.OccasionId" required>
                            <option value="">-- Select an occasion --</option>
                        </select>
                        <span asp-validation-for="OccasionId" class="text-danger text-sm"></span>
                    </div>

                    <div class="form-group">
                        <label for="Price">Price (USD)</label>
                        <input type="number" asp-for="Price" class="form-control number-only" value="0" required min="0">
                        <span asp-validation-for="Price" class="text-danger text-sm"></span>
                    </div>

                    <div class="form-group">
                        <label for="ImageFiles">Upload Product Images (At least 1 image is required)</label>
                        <input type="file" id="ImageFiles" name="ImageFiles" class="form-control-file form-control" accept="image/*" multiple required />
                        <span class="text-danger text-sm" id="imageFilesValidationError"></span>
                    </div>

                    <div class="form-group">
                        <label for="Description">Product Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-group form-check">
                        <input type="checkbox" asp-for="IsActive" class="form-check-input" checked>
                        <label class="form-check-label" for="IsActive">Publish publicly on storefront</label>
                    </div>
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Save Product</button>
                    <a asp-action="Index" class="btn btn-default">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/admin/plugins/jquery-validation/jquery.validate.min.js"></script>

    <script>
        $(document).ready(function () {
                $('.number-only').on('keydown', function (e) {
            if ($.inArray(e.keyCode, [46, 8, 9, 27, 13]) !== -1 ||
                (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
                (e.keyCode === 67 && (e.ctrlKey === true || e.metaKey === true)) ||
                (e.keyCode === 86 && (e.ctrlKey === true || e.metaKey === true)) ||
                (e.keyCode === 88 && (e.ctrlKey === true || e.metaKey === true)) ||
                (e.keyCode >= 35 && e.keyCode <= 39)) {
                     return;
            }


            if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
                e.preventDefault();
            }
        });

        $('.number-only').on('paste', function (e) {
            var pasteData = e.originalEvent.clipboardData.getData('text');
            if ($.isNumeric(pasteData) == false) {
                e.preventDefault();
            }
        });
        // -----------------------------------------------------

            var form = $('#bouquetForm');
            var imageInput = $('#ImageFiles');
            var imageErrorMsg = $('#imageFilesValidationError');

            form.on('submit', function (e) {
                var formElement = form[0];
                var isValid = true;

                // 1. Check custom verification logic for the image element explicitly
                if (imageInput[0].files.length === 0) {
                    imageInput.addClass('is-invalid');
                    imageErrorMsg.text('Please choose at least one image file to upload.');
                    isValid = false;
                } else {
                    imageInput.removeClass('is-invalid');
                    imageErrorMsg.text('');
                }

                // 2. Validate standard text/dropdown inputs using native checkValidity
                if (!formElement.checkValidity() || !isValid) {
                    e.preventDefault();
                    e.stopPropagation();

                    $('#validationSummaryAlert').fadeIn();

                    // Apply the red border wrapper classes to standard empty fields
                    form.find('.form-control').each(function () {
                        if (!this.checkValidity()) {
                            $(this).addClass('is-invalid');
                        } else {
                            if (this.id !== 'ImageFiles') {
                                $(this).removeClass('is-invalid');
                            }
                        }
                    });
                }

                form.addClass('was-validated');
            });

            // Real-time listener to remove red outlines as the user fixes errors
            form.find('.form-control').on('input change', function () {
                if (this.id === 'ImageFiles') {
                    if (this.files.length > 0) {
                        $(this).removeClass('is-invalid');
                        imageErrorMsg.text('');
                    } else {
                        $(this).addClass('is-invalid');
                        imageErrorMsg.text('Please choose at least one image file to upload.');
                    }
                } else {
                    if (this.checkValidity()) {
                        $(this).removeClass('is-invalid');
                    } else {
                        $(this).addClass('is-invalid');
                    }
                }

                // Smoothly dismiss the top alert banner when everything becomes valid
                var filesSelected = imageInput[0].files.length > 0;
                if (form[0].checkValidity() && filesSelected) {
                    $('#validationSummaryAlert').fadeOut();
                }
            });
        });
    </script>
}
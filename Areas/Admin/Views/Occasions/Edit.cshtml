@model Shopv2.Models.Occasion
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Update Occasion";
}

<section class="content pt-4">
    <div class="container-fluid">
        <div class="card card-warning">
            <div class="card-header">
                <h3 class="card-title">Edit Occasion</h3>
            </div>

            <form asp-action="Edit" method="post" asp-route-id="@Model.Id" id="occasionForm" novalidate>
                <input type="hidden" asp-for="Id" />

                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert" style="display:none;" id="validationSummaryAlert">
                        <i class="icon fas fa-exclamation-triangle"></i>
                        Please fill in all required fields before updating.
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>

                    <div class="form-group">
                        <label for="Name">Occasion Name</label>
                        <input type="text" asp-for="Name" class="form-control" id="Name" required>
                        <span asp-validation-for="Name" class="text-danger text-sm"></span>
                    </div>
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-warning">Update</button>
                    <a asp-action="Index" class="btn btn-default">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/admin/plugins/jquery-validation/jquery.validate.min.js"></script>

    <script>
        $(document).ready(function () {
            var form = $('#occasionForm');

            form.on('submit', function (e) {
                var formElement = form[0];

                // If form elements do not pass validity validation checks
                if (!formElement.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();

                    $('#validationSummaryAlert').fadeIn();

                    // Iterate inputs and add visual validation error indicator wrappers
                    form.find('.form-control').each(function () {
                        if (!this.checkValidity()) {
                            $(this).addClass('is-invalid'); // Highlights input field border in red
                        } else {
                            $(this).removeClass('is-invalid');
                        }
                    });
                }

                form.addClass('was-validated');
            });

            // Dynamic interaction: clear red highlighting structural classes real-time as data enters inputs
            form.find('.form-control').on('input change', function () {
                if (this.checkValidity()) {
                    $(this).removeClass('is-invalid');
                } else {
                    $(this).addClass('is-invalid');
                }

                // Smoothly fade out global warning layout component if data inputs pass validation rules
                if (form[0].checkValidity()) {
                    $('#validationSummaryAlert').fadeOut();
                }
            });
        });
    </script>
}
@model IEnumerable<Shopv2.Models.Occasion>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Occasions Management";

    // Read pagination and search data from ViewBag
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string currentFilter = ViewBag.CurrentFilter as string;
}
@if (TempData["AlertMessage"] != null)
{
    <div class="alert alert-@TempData["AlertType"] alert-dismissible fade show" role="alert">
        <i class="icon fas @(TempData["AlertType"]?.ToString() == "success" ? "fa-check-circle" : "fa-exclamation-triangle")"></i>
        @TempData["AlertMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}


<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Manage Occasions</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">

            <div class="card-header">
                <div class="row">
                    <!-- Create Button -->
                    <div class="col-md-4">
                        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Add New</a>
                    </div>
                    <!-- Search Form -->
                    <div class="col-md-8">
                        <form asp-action="Index" method="get" class="form-inline float-md-right mt-2 mt-md-0">
                            <div class="input-group input-group-sm">
                                <input type="text" name="searchString" class="form-control" placeholder="Search occasion name..." value="@currentFilter" />
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-default">
                                        <i class="fas fa-search"></i> Search
                                    </button>
                                    @if (!string.IsNullOrEmpty(currentFilter))
                                    {
                                        <a asp-action="Index" class="btn btn-secondary btn-sm">Clear Filter</a>
                                    }
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 10%">ID</th>
                            <th>Occasion Name</th>
                            <th style="width: 20%">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Name</td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this item?')"><i class="fas fa-trash"></i> Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center">No matching data found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar: Always displays Page 1 if there's minimal data -->
            <div class="card-footer clearfix">
                <ul class="pagination pagination-sm m-0 float-right">
                    <!-- Previous Page Button -->
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@currentFilter">&laquo;</a>
                    </li>

                    <!-- Page Numbers Logic -->
                    @if (totalPages <= 1)
                    {
                        <!-- Fallback: Force display Page 1 active if total pages are 0 or 1 -->
                        <li class="page-item active">
                            <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-searchString="@currentFilter">1</a>
                        </li>
                    }
                    else
                    {
                        <!-- Dynamic loop for multiple pages -->
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@currentFilter">@i</a>
                            </li>
                        }
                    }

                    <!-- Next Page Button -->
                    <li class="page-item @(currentPage == totalPages || totalPages <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@currentFilter">&raquo;</a>
                    </li>
                </ul>
            </div>

        </div>
    </div>


</section>

